# ============================ BẮT BUỘC ============================
# Token bot, lấy tại https://discord.com/developers/applications -> Bot -> Reset Token
# TUYỆT ĐỐI không commit file .env và không dán token vào chat/công khai.
DISCORD_TOKEN=

# ============================ KHUYÊN DÙNG ==========================
# ID server của bạn. Có ID này thì lệnh slash hiện NGAY; bỏ trống thì phải chờ
# tới ~1 giờ Discord mới đồng bộ lệnh toàn cục.
GUILD_ID=

# Cách kích hoạt khi có người mention:
#   bot = phải mention bot rồi mention người cần xem: @Bot @user  (mặc định, chống spam)
#   any = mention bất kỳ ai bot cũng trả lời (dễ spam, dùng ở kênh riêng)
#   off = tắt, chỉ dùng lệnh /whois và !info
MENTION_TRIGGER=bot

# Tiền tố lệnh chữ: "!info @user". Đặt cũng được, để mặc định cũng được.
COMMAND_PREFIX=!info

# true = mọi phản hồi của /whois chỉ người gọi thấy (thay đổi hành vi với mọi người)
EPHEMERAL=false

# Chống spam: số giây tối thiểu giữa hai lần xem cùng một người trong cùng server.
COOLDOWN_SECONDS=8

# ID role được xem dữ liệu "restricted" (ghi chú nội bộ + tài khoản visibility=restricted).
# Người có quyền Quản lý server luôn được xem. Bỏ trống = chỉ admin/Manage Server.
PRIVACY_ROLE_ID=

# Đường dẫn file dữ liệu
DATA_PATH=data/accounts.json

# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO

# ============================== TUỲ CHỌN ===========================
# Bật để hiện trạng thái online / đang chơi gì.
# Phải bật PRESENCE INTENT trong Developer Portal trước, nếu không bot sẽ không khởi động.
PRESENCE_INTENT=false

# Tra thêm hồ sơ GitHub công khai của các tài khoản type=github.
GITHUB_ENRICH=false

# Token GitHub để tăng hạn mức API (5.000 req/giờ thay vì 60 req/giờ).
# Chỉ cần quyền đọc public. Đây là token riêng của bạn — không commit, không chia sẻ.
GITHUB_TOKEN=
